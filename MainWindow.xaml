<Window x:Class="AppUpdater.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AppUpdater.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="MrLurix App Updater"
        Height="640" Width="720"
        MinHeight="480" MinWidth="560"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable, Segoe UI">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid>
        <Border x:Name="WindowBorder" CornerRadius="8" Background="{StaticResource GlassGradient}" Margin="8" BorderThickness="1" BorderBrush="#33FF1744">
            <Border.Effect>
                <DropShadowEffect x:Name="WindowShadow" ShadowDepth="0" BlurRadius="24" Color="Black" Opacity="0.5"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                </Grid.RowDefinitions>

                <!-- ── Title Bar ── -->
                <Grid Grid.Row="0" Background="#1A080C"
                      MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" Cursor="Hand">
                    <Border CornerRadius="8,8,0,0" Background="#1A080C" IsHitTestVisible="False"/>
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                            <Border Width="14" Height="14" CornerRadius="7"
                                    Background="{StaticResource AccentBrush}" Margin="0,0,8,0"/>
                            <TextBlock Text="MrLurix App Updater" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SettingsBtn" Click="ToggleSettings_Click"
                                    Style="{StaticResource TitleBarButton}" ToolTip="Settings">
                                <TextBlock Text="⚙" FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Button>
                            <Button x:Name="MinimizeBtn" Click="Minimize_Click"
                                    Style="{StaticResource TitleBarButton}">
                                <Canvas Width="12" Height="12">
                                    <Line X1="1" Y1="6" X2="11" Y2="6"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Button>
                            <Button x:Name="CloseBtn" Click="Close_Click"
                                    Style="{StaticResource CloseButton}">
                                <Canvas Width="12" Height="12">
                                    <Line X1="1" Y1="1" X2="11" Y2="11"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                    <Line X1="11" Y1="1" X2="1" Y2="11"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Canvas>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ── Main Content (responsive) ── -->
                <Grid Grid.Row="1" Margin="12,0,12,0">
                    <Viewbox Stretch="Uniform" StretchDirection="Both">
                        <Grid Width="680" Height="540">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Status Banner -->
                            <Border Grid.Row="0" Margin="24,16,24,8" Padding="16,12"
                                    CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{StaticResource BgBorderBrush}"
                                    Background="{StaticResource BgCardBrush}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16"
                                            Background="{StaticResource BgBorderBrush}" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding StatusIcon}" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Foreground>
                                                <SolidColorBrush Color="{Binding StatusColor}"/>
                                            </TextBlock.Foreground>
                                        </TextBlock>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="Medium"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="Last checked: "/>
                                            <Run Text="{Binding LastCheckTime}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="⟳"
                                            Style="{StaticResource NeonSecondaryButton}"
                                            Width="36" MinWidth="0" Padding="0"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            IsEnabled="{Binding IsIdle}"
                                            ToolTip="Check for updates"
                                            FontSize="16"/>
                                </Grid>
                            </Border>

                            <!-- Updates Section -->
                            <Grid Grid.Row="1" Margin="24,6,24,0"
                                  Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="{Binding UpdateCountText}"
                                           Margin="2,0,0,6"/>
                                <Border Grid.Row="1" CornerRadius="6" BorderThickness="1"
                                        BorderBrush="{StaticResource BgBorderBrush}"
                                        Background="{StaticResource BgCardBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Hidden"
                                                  BorderThickness="0" Padding="0">
                                        <ItemsControl ItemsSource="{Binding Updates}"
                                                      Background="Transparent" BorderThickness="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Padding="16,10,16,10"
                                                            BorderThickness="0,0,0,1"
                                                            BorderBrush="{StaticResource BgBorderBrush}"
                                                            Background="Transparent">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3"
                                                                    Background="{StaticResource AccentBrush}"
                                                                    Margin="0,0,12,0" VerticalAlignment="Center"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="13"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource TextPrimaryBrush}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                                               Text="{Binding Id}" Margin="0,0,12,0"
                                                                               TextTrimming="CharacterEllipsis" MaxWidth="260"/>
                                                                    <TextBlock FontSize="11" Foreground="{StaticResource WarningBrush}">
                                                                        <Run Text="{Binding CurrentVersion}"/>
                                                                        <Run Text="→" Foreground="{StaticResource AccentBrush}"/>
                                                                        <Run Text="{Binding AvailableVersion}"/>
                                                                    </TextBlock>
                                                                </StackPanel>
                                                            </StackPanel>
                                                            <Border Grid.Column="2" Padding="6,3,6,3" CornerRadius="3"
                                                                    Background="{StaticResource BgHoverBrush}"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Source}" FontSize="10"
                                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>
                            </Grid>

                            <!-- No updates -->
                            <Border Grid.Row="1" Margin="24,6,24,0"
                                    Visibility="{Binding HasNoUpdates, Converter={StaticResource BoolToVis}}"
                                    CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{StaticResource BgBorderBrush}"
                                    Background="{StaticResource BgCardBrush}">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <Border Width="48" Height="48" CornerRadius="24"
                                            Background="{StaticResource BgHoverBrush}" Margin="0,0,0,12"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="✓" FontSize="24"
                                                   Foreground="{StaticResource SuccessBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="All applications are up to date"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               FontSize="14" FontWeight="Medium" HorizontalAlignment="Center"/>
                                    <TextBlock Text="No updates available at this time"
                                               Foreground="{StaticResource TextSecondaryBrush}"
                                               FontSize="12" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Action Buttons + Self-update banner -->
                            <StackPanel Grid.Row="2" Margin="24,12,24,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Check for updates" MinWidth="140"
                                            Command="{Binding CheckForUpdatesCommand}"
                                            Style="{StaticResource NeonSecondaryButton}"
                                            Margin="0,0,10,0"
                                            IsEnabled="{Binding IsIdle}"/>
                                    <Button Content="Update all" MinWidth="140"
                                            Command="{Binding RunUpdatesCommand}"
                                            Style="{StaticResource NeonPrimaryButton}"
                                            IsEnabled="{Binding HasUpdates}"/>
                                </StackPanel>
                                <Border Margin="0,8,0,0" Padding="10,6"
                                        CornerRadius="4" BorderThickness="1"
                                BorderBrush="{StaticResource PurpleBrush}"
                                Background="{StaticResource BgCardBrush}"
                                Visibility="{Binding AppUpdateAvailable, Converter={StaticResource BoolToVis}}">
                            <TextBlock Cursor="Hand" FontSize="11"
                                       Foreground="{StaticResource PurpleBrush}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis">
                                <Hyperlink Command="{Binding CheckAppUpdateCommand}"
                                           Foreground="{StaticResource PurpleBrush}"
                                                   TextDecorations="None">
                                            <Run Text="{Binding AppUpdateText}"/>
                                        </Hyperlink>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Progress Section -->
                            <Border Grid.Row="3" Margin="24,8,24,0" Padding="14,10"
                                    CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{StaticResource BgBorderBrush}"
                                    Background="{StaticResource BgCardBrush}"
                                    Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <ProgressBar Value="{Binding ProgressValue}"
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}"
                                                 Margin="0,0,0,6"/>
                                    <TextBlock Text="{Binding CurrentPackage}"
                                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>

                            <!-- Settings Panel -->
                            <Border Grid.Row="4" Margin="24,8,24,0" Padding="14,10"
                                    CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{StaticResource BgBorderBrush}"
                                    Background="{StaticResource BgCardBrush}"
                                    Visibility="{Binding IsSettingsOpen, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Settings" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                                    <!-- Scheduled download -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Scheduled downloads" FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding DownloadWindowHint}" FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource ToggleSwitch}"
                                                      IsChecked="{Binding ScheduledDownloadEnabled}"
                                                      VerticalAlignment="Center"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="From" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="1" Width="62"
                                                  ItemsSource="{Binding Hours}"
                                                  SelectedItem="{Binding DownloadStartHour}"
                                                  Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="2" Text="to" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <ComboBox Grid.Column="3" Width="62"
                                                  ItemsSource="{Binding Hours}"
                                                  SelectedItem="{Binding DownloadEndHour}"/>
                                    </Grid>

                                    <!-- Shutdown after update -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="Shutdown system after updates finish" FontSize="11"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="System will shut down 60 s after the last update completes"
                                                       FontSize="10"
                                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Cancel shutdown" MinWidth="0" Padding="8,0"
                                                    Style="{StaticResource NeonSecondaryButton}"
                                                    Command="{Binding CancelShutdownCommand}"
                                                    Visibility="{Binding CanCancelShutdown, Converter={StaticResource BoolToVis}}"
                                                    Margin="0,0,8,0" Height="26" FontSize="10"/>
                                            <ToggleButton Style="{StaticResource ToggleSwitch}"
                                                          IsChecked="{Binding ShutdownAfterUpdate}"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </Viewbox>
                </Grid>

                <!-- ── Status Bar ── -->
                <Grid Grid.Row="2">
                    <Border CornerRadius="0,0,8,8" Background="#1A080C"/>
                    <Border Margin="10,0">
                        <Grid>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" MaxWidth="300">
                                    <Run Text="{Binding UpdateCountText}"/>
                                    <Run Text=" · "/>
                                    <Hyperlink Command="{Binding CheckAppUpdateCommand}"
                                               Foreground="{StaticResource PurpleBrush}"
                                               FontSize="10">
                                        <Run Text="{Binding AppUpdateText}"/>
                                    </Hyperlink>
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Ellipse Width="5" Height="5" Fill="{StaticResource PurpleBrush}"
                                         Margin="0,0,4,0"/>
                                <TextBlock Text="Running in background"
                                           FontSize="10" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

            </Grid>
        </Border>
    </Grid>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      GlassFrameThickness="0"
                      ResizeBorderThickness="4"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
</Window>
